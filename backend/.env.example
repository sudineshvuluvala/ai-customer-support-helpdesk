# Copy to .env and fill in real values. NEVER commit .env
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=480

# MySQL (database: customer_support_db)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=customer_support_db
# Optional: overrides the parts above
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/customer_support_db

CORS_ORIGINS=http://localhost:5173
UPLOAD_FOLDER=app/uploads
MAX_UPLOAD_MB=5

# Email (leave MAIL_ENABLED=false to disable; failures never break ticket operations)
