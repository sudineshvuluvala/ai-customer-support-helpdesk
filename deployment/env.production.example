# Production Environment Configuration Template
FLASK_ENV=production
SECRET_KEY=generate-a-strong-random-64-char-string-in-production
JWT_EXPIRY_MINUTES=480

# Production Database (Amazon RDS or Separate EC2 MySQL)
DB_HOST=rds-instance.xyz.ap-southeast-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=helpdesk_user
DB_PASSWORD=strong_production_password_here
DB_NAME=customer_support_db

# Frontend Domain & CORS
CORS_ORIGINS=https://helpdesk.example.com
UPLOAD_FOLDER=/var/www/helpdesk/backend/app/uploads
MAX_UPLOAD_MB=5

# SMTP Email Dispatch
MAIL_ENABLED=true
MAIL_SERVER=email-smtp.ap-southeast-2.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=aws-ses-smtp-username
MAIL_PASSWORD=aws-ses-smtp-password
MAIL_FROM=support@helpdesk.example.com

# AI Integration (Optional)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=15
